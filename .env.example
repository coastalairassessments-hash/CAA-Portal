# Copy to .env.local for local work. On Netlify, add these in Site settings > Environment variables.
# NEVER commit real values. NEVER paste them into chat.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Used to scramble IP addresses before storing.
IP_HASH_SALT=

# Email alerts via Resend (optional; skipped if blank)
RESEND_API_KEY=
ALERT_EMAIL=
ALERT_FROM=

SUPABASE_PUBLISHABLE_KEY=

# Stripe (Dashboard > Developers). Webhook secret starts with whsec_ and is shown when you add the endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
